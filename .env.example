# Example environment variables for PTCG Event Manager

# ============================================
# DATABASE
# ============================================
POSTGRES_USER="app"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="ptcg_events"
POSTGRES_HOST_PORT="5432"
DATABASE_URL="postgresql://user:password@localhost:5432/ptcg_events?schema=public"

# ============================================
# SUPABASE
# ============================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-public-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Webhook secret for Supabase Auth webhooks
# Generate with: openssl rand -base64 32
# IMPORTANT: Must match the secret configured in Supabase Dashboard > Authentication > Webhooks
SUPABASE_WEBHOOK_SECRET="your-webhook-secret-here"

# ============================================
# APPLICATION
# ============================================
# Base URL of your application (used for magic link redirects)
# Development: http://localhost:3000
# Production: https://your-domain.com
APP_BASE_URL="http://localhost:3000"

# Server-side pepper for password preprocessing (recommended in all environments)
# Generate with: openssl rand -base64 48
PASSWORD_PEPPER="replace-with-a-random-long-secret-pepper"

# Deploy timestamp (for session invalidation on new deployments)
DEPLOY_TIMESTAMP=""

# ============================================
# NOTES
# ============================================
# 1. Never commit .env files to version control
# 2. Copy this file to .env and fill in your actual values
# 3. For production, use environment variables in your hosting platform
# 4. Generate webhook secret: openssl rand -base64 32
# 5. For local dev with Docker Postgres:
#    docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile dev up -d
